# CabinShield Ground API (CabinShield-Backend). Leave empty to run fully offline on bundled data.
# Copy to .env.local. On a device/simulator use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Only when the server sets CS_API_KEY. Note: EXPO_PUBLIC_* values are visible in the app bundle.
EXPO_PUBLIC_API_KEY=
